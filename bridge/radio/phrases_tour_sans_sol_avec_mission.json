        "color": "#34d399",
        "when": "departureTower",
        "groundVariant": "towerAsGround",
        "requires": ["tour-contact-start"],
        "surface": "ground",
        "text": "{shortCs}, {acType} VFR avec {pob}, au parking{atisReceived}, je demande le roulage {destination}.",
