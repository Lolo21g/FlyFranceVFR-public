        "response": "{shortCs}, {station}, transpondeur {towerSquawk}, roulez au point d'attente {holdingFull}, rappelez Prêt."
      },
      {
        "id": "tour-taxi-readback",
        "phase": "Collationnement",
        "color": "#fbbf24",
        "groundVariant": "towerAsGround",
