{
  "service": "tour",
  "context": "avec_mission",
  "scenarios": {
    "departure": [
      {
        "id": "tour-contact-start",
        "kind": "bonjour",
        "phase": "Contact",
        "color": "#60a5fa",
        "when": "departureTower",
        "text": "{station} de {cs}, bonjour.",
        "motsValidation": [["bonjour"]],
        "response": "{shortCs}, {station}, bonjour."
      },
      {
        "id": "tour-ready",
        "kind": "params_departure",
        "phase": "Départ",
        "color": "#34d399",
        "when": "departureTower",
        "groundVariant": "withGround",
        "requires": ["tour-contact-start"],
        "surface": "ground",
        "text": "{shortCs}, au point d'attente {holdingFull}, prêt au départ {destination}.",
        "motsValidation": [["attente"], ["départ"]],
        "response": "{shortCs}, {station}, transpondeur {towerSquawk}, {piste}, {wind}, {qnh}. {departureInstruction} Maintenez point d'attente."
      },
      {
        "id": "tour-readback-start",
        "kind": "lineup",
        "phase": "Collationnement",
        "color": "#fbbf24",
        "when": "departureTower",
        "groundVariant": "withGround",
        "requires": ["tour-ready"],
        "surface": "ground",
        "text": "Transpondeur {towerSquawk}, {qnh}. {departureReadback} Je maintiens point d'attente, {shortCs}.",
        "motsValidation": [["transpondeur"], ["maintiens","attente"]],
        "response": "{shortCs}, alignez-vous et attendez piste {runway}."
      },
      {
        "id": "tour-lineup-readback",
        "phase": "Collationnement",
        "color": "#fbbf24",
        "when": "departureTower",
        "groundVariant": "withGround",
        "requires": ["tour-readback-start"],
        "surface": "ground",
        "text": "Je m'aligne et j'attends {piste}, {shortCs}.",
        "motsValidation": [["attend"], ["piste"]],
        "response": null
      },
      {
        "id": "tour-ready-lineup",
        "kind": "depart",
        "phase": "Décollage",
        "color": "#38bdf8",
        "when": "departureTower",
        "groundVariant": "withGround",
        "requires": ["tour-lineup-readback"],
        "surface": "ground",
        "text": "{shortCs}, aligné {piste}, prêt au décollage.",
        "motsValidation": [["piste"], ["décollage"]],
        "response": "{shortCs}, {piste}, autorisé décollage, {wind}."
      },
      {
        "id": "tour-takeoff-readback",
        "phase": "Collationnement",
        "color": "#fbbf24",
        "when": "departureTower",
        "groundVariant": "withGround",
        "requires": ["tour-ready-lineup"],
        "surface": "ground",
        "text": "{piste}, je décolle, {shortCs}.",
        "motsValidation": [["décolle"]],
        "response": null
      },
      {
        "id": "tour-leave-start",
        "kind": "quitter",
        "phase": "Quitter",
        "color": "#64748b",
        "when": "departureTower",
        "requires": ["tour-takeoff-readback"],
        "surface": "air",
        "text": "{shortCs}, passe {departurePoint} à {altitude} pieds, pour quitter la fréquence.",
        "motsValidation": [["quitte"], ["fréquence"]],
        "response": "{shortCs}, vous pouvez quitter, au revoir, bon vol."
      },
      {
        "id": "tour-leave-start-readback",
        "phase": "Collationnement",
        "color": "#fbbf24",
        "when": "departureTower",
        "requires": ["tour-leave-start"],
        "surface": "air",
        "text": "Je quitte la fréquence, {farewell}, {shortCs}.",
        "motsValidation": [["quitte"]],
        "response": null
      }
